# Скопируйте в .env и заполните:  cp .env.example .env

# Домен, на который указывает A-запись DNS сервера. Нет своего домена — используйте
# бесплатный вида <IP-сервера>.sslip.io (например, 203.0.113.10.sslip.io): HTTPS тоже будет работать.
DOMAIN=203.0.113.10.sslip.io

# Вход в интерфейс. Хэш пароля получить так:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'ваш-пароль'
# Хэш обязательно в ОДИНАРНЫХ кавычках (в нём есть символы $).
BASIC_AUTH_USER=team
BASIC_AUTH_HASH='$2a$14$ЗАМЕНИТЕ_НА_ВЫВОД_hash-password'

# Ограничение памяти контейнера с интерфейсом (выборка «Россия» на странице «Кластеры» — до 3–4 ГБ;
# пересчёт со страницы «Обновление данных» идёт в том же контейнере — ещё до 3 ГБ)
APP_MEM_LIMIT=7g

# 1 — включить метод CANUS (PyTorch, +~700 МБ к образу, медленный на CPU)
WITH_CANUS=0
