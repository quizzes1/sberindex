# Обратный прокси перед Streamlit: автоматический HTTPS (Let's Encrypt). Вход без пароля (решение команды).
# Переменные берутся из .env (см. .env.example).
{$DOMAIN} {
	encode zstd gzip

	# Streamlit работает через WebSocket — Caddy проксирует его без доп. настроек
	reverse_proxy app:8501

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
